 "declaration": {
  "case_id": "tan2015-fcu-wet",
  "title": "谭爱华2015 风机盘管湿工况（百叶窗花边翅片，水-空气）",
  "status": "declared_before_run",
  "declared_at": "2026-10-19，U2实施后、首次运行前",
  "source": {
   "citation": "谭爱华. 小管径风机盘管传热与流阻及噪声特性研究[D]. 华南理工大学工程硕士学位论文, 2015."
  },
  "scope": {
   "included": "优化前9.52 mm管5种（03#、04#、05#、06#、14#，各7台）；优化后7 mm管05#、06#、14#（各7台）；共55台（剔除1台录入错误）",
   "excluded": [
    {
     "what": "优化后03#、04#（14台）",
     "why": "30根管分4路不等分，整体模型不能表示；待按图2-3录入逐管流路"
    },
    {
     "what": "优化前06#第5台（整台）",
     "why": "表3-5出风湿球19.52 ℃与进风湿球相同、高于出风干球，物理上不可能；风量推导需要出风状态，故整台剔除（运行时发现，属录入错误剔除，不涉及结果筛选）"
    }
   ]
  },
  "model": {
   "software": "core 0.1.0.dev9（整盘逆流集总）",
   "air_side": "Wang等1999百叶片j/f（geometry.fin_type=louver）",
   "fin_efficiency": "Schmidt（文献数据整理所用方法）",
   "wet_surface": "threlkeld_braun",
   "no_multipliers": true
  },
  "inputs_derivation": [
   {
    "field": "管长、管高、回路数、排数、每排管数、外径、壁厚、FPI、片厚",
    "level": "D0",
    "source": "表2-2、表2-3（p.19-20）"
   },
   {
    "field": "Pt",
    "level": "D1",
    "value": "203.2/8=25.4 mm；210/10=21 mm"
   },
   {
    "field": "Pl",
    "level": "D2",
    "value": "22 mm（9.52管）、12.7 mm（7管）",
    "source": "按比例流路图2-2/2-3量取（Pl/Pt=0.855、0.613）；表中“盘管宽”44/25.4 mm与3排矛盾，疑为2排值"
   },
   {
    "field": "片距",
    "level": "D1",
    "value": "25.4/FPI"
   },
   {
    "field": "Lh/Lp（百叶高度/间距）",
    "level": "D4",
    "value": "扫描0.24、0.40、0.583、0.824（Wang 1999样本范围的两端与中间；关联式只依赖该比值）；参考值0.583（Wang样本最常见的Type I）",
    "note": "图1-9照片估得Lp约1.3 mm，低于Wang样本下限1.7 mm，不能作为输入"
   },
   {
    "field": "湿空气进口状态",
    "level": "D1",
    "value": "干球+湿球→含湿量，大气压取101.325 kPa（D4，广州）"
   },
   {
    "field": "湿工况试验中的实际风量",
    "level": "D2",
    "value": "m_da = Q风侧/(h进−h出)，h由实测进出风干湿球求得",
    "note": "表中“标准工况下干风量”是GB/T 19232干工况风量测试的结果，不是制冷试验时的风量；由风侧制冷量反推的风量比它低5%~10%。敏感性：改用干风量×1.2 kg/m³"
   },
   {
    "field": "水流量",
    "level": "D1",
    "value": "表中m³/h×进水温度下的水密度"
   },
   {
    "field": "管内表面",
    "level": "D4",
    "value": "按光管（论文未说明是否内螺纹）"
   },
   {
    "field": "翅片导热系数、管导热系数",
    "level": "D4",
    "value": "204、390 W/(m·K)"
   },
   {
    "field": "03#盘管2根盲管",
    "level": "D0",
    "value": "整体模型无法扣除，按24根全部通水计算（偏高方向，记录）"
   }
  ],
  "comparison": {
   "quantities": [
    {
     "name": "水侧制冷量 Qw",
     "why": "与风量推导所用的风侧数据独立"
    },
    {
     "name": "显热比 SHR = 显热/全热（由实测进出风状态计算，风量相消）",
     "why": "检验湿表面模型的热质分配"
    }
   ],
   "not_compared": [
    "风侧制冷量（参与风量推导）",
    "实际供冷量（含风侧）",
    "水阻力（模型只含直管摩擦）"
   ],
   "tolerance": {
    "Qw_relative": 0.1,
    "SHR_absolute": 0.05
   },
   "verdict_rule": "逐台按参考比值0.583判定；另报告Lh/Lp扫描区间。全部比值都在容差内=稳健通过；仅参考值在容差内=条件通过；否则不通过"
  }
 }
}
